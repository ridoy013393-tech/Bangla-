rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             request.auth.token.get('email', '') == 'mehedi0169019@gmail.com' &&
             request.auth.token.get('email_verified', false) == true;
    }

    function isModDocUnrestricted(data) {
      return data.get('banned', false) != true &&
             data.get('deletedByAdmin', false) != true &&
             !(
               'mutedUntil' in data &&
               data.mutedUntil is timestamp &&
               data.mutedUntil > request.time
             );
    }

    function isNotModRestricted(uid) {
      return !exists(/databases/$(database)/documents/moderation/$(uid)) ||
             isModDocUnrestricted(get(/databases/$(database)/documents/moderation/$(uid)).data);
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBlockedBetween(uidA, uidB) {
      return exists(/databases/$(database)/documents/users/$(uidA)/blockedUsers/$(uidB)) ||
             exists(/databases/$(database)/documents/users/$(uidB)/blockedUsers/$(uidA));
    }

    function isValidUidList(val) {
      return val is list &&
             val.size() <= 50 &&
             (val.size() == 0 || val[0] is string);
    }

    function isDirectChatBlocked(data) {
      return !data.get('isGroup', false) &&
             data.participants.size() == 2 &&
             isBlockedBetween(data.participants[0], data.participants[1]);
    }

    function isDirectChatIdForUser(chatId, uid) {
      return isValidId(uid) && (
        chatId.matches('^' + uid + '_.+$') ||
        chatId.matches('^.+_' + uid + '$')
      );
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    function isValidPublicProfile(data) {
      return data.keys().hasAll([
               'uid', 'name', 'username', 'online', 'discoverable',
               'showOnlineStatus', 'showLastSeen', 'showReadReceipts',
               'lastSeen', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'uid', 'name', 'username', 'phoneLookup', 'photoUrl', 'about',
               'online', 'discoverable', 'showOnlineStatus', 'showLastSeen',
               'showReadReceipts', 'showProfilePhoto', 'showAbout', 'verified',
               'lastSeen', 'createdAt', 'updatedAt'
             ]) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.username.matches('^[a-z0-9_]+$') &&
             (!('phoneLookup' in data) || data.phoneLookup == null || (data.phoneLookup is string && data.phoneLookup.size() <= 20)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('about' in data) || data.about == null || (data.about is string && data.about.size() <= 180)) &&
             data.online is bool &&
             data.discoverable is bool &&
             data.showOnlineStatus is bool &&
             data.showLastSeen is bool &&
             data.showReadReceipts is bool &&
             (!('showProfilePhoto' in data) || data.showProfilePhoto == null || data.showProfilePhoto is bool) &&
             (!('showAbout' in data) || data.showAbout == null || data.showAbout is bool) &&
             (!('verified' in data) || data.verified == null || data.verified is bool) &&
             data.lastSeen is timestamp && data.lastSeen <= request.time &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPrivateUser(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'messagePreviewEnabled', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'phone', 'fcmToken', 'messagePreviewEnabled', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             data.phone is string && data.phone.size() <= 25 &&
             (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() <= 300)) &&
             data.messagePreviewEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBlockedUser(data) {
      return data.keys().hasAll(['blockedUid', 'blockedName', 'createdAt']) &&
             data.keys().hasOnly(['blockedUid', 'blockedName', 'blockedUsername', 'blockedPhotoUrl', 'createdAt']) &&
             data.blockedUid is string && data.blockedUid.size() >= 1 && data.blockedUid.size() <= 128 &&
             data.blockedName is string && data.blockedName.size() >= 1 && data.blockedName.size() <= 60 &&
             (!('blockedUsername' in data) || data.blockedUsername == null || (data.blockedUsername is string && data.blockedUsername.size() <= 30)) &&
             (!('blockedPhotoUrl' in data) || data.blockedPhotoUrl == null || (data.blockedPhotoUrl is string && data.blockedPhotoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFavoriteContact(data) {
      return data.keys().hasAll(['favoriteUid', 'name', 'createdAt']) &&
             data.keys().hasOnly(['favoriteUid', 'name', 'username', 'photoUrl', 'createdAt']) &&
             data.favoriteUid is string && data.favoriteUid.size() >= 1 && data.favoriteUid.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 30)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCallLog(data) {
      return data.keys().hasAll(['peerUid', 'peerName', 'direction', 'callType', 'durationSeconds', 'createdAt']) &&
             data.keys().hasOnly(['peerUid', 'peerName', 'peerPhotoUrl', 'direction', 'callType', 'durationSeconds', 'createdAt']) &&
             data.peerUid is string && data.peerUid.size() >= 1 && data.peerUid.size() <= 128 &&
             data.peerName is string && data.peerName.size() >= 1 && data.peerName.size() <= 60 &&
             (!('peerPhotoUrl' in data) || data.peerPhotoUrl == null || (data.peerPhotoUrl is string && data.peerPhotoUrl.size() <= 500)) &&
             data.direction in ['incoming', 'outgoing', 'missed'] &&
             data.callType in ['audio', 'video'] &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterUid', 'reportedUid', 'reason', 'createdAt']) &&
             data.keys().hasOnly(['reporterUid', 'reportedUid', 'reason', 'details', 'createdAt']) &&
             data.reporterUid is string && data.reporterUid.size() >= 1 && data.reporterUid.size() <= 128 &&
             data.reportedUid is string && data.reportedUid.size() >= 1 && data.reportedUid.size() <= 128 &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 60 &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChat(data) {
      return data.keys().hasAll([
               'participants', 'participantNames', 'participantPhotos',
               'lastMessage', 'lastMessageType', 'lastSenderId', 'lastMessageTime',
               'unreadCounts', 'typingUids', 'createdBy', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'participants', 'participantNames', 'participantPhotos',
               'isGroup', 'isSelfChat', 'groupName', 'groupDescription', 'groupPhotoUrl', 'adminUids', 'onlyAdminsCanSend',
               'streakCount', 'lastStreakDate',
               'lastMessage', 'lastMessageType', 'lastSenderId', 'lastMessageTime',
               'lastMessageDelivered', 'lastMessageRead',
               'unreadCounts', 'typingUids',
               'pinnedMessageId', 'pinnedMessageText', 'pinnedMessageSender',
               'disappearingHours', 'mutedBy', 'pinnedBy', 'archivedBy', 'hiddenBy', 'clearedAt',
               'createdBy', 'createdAt', 'updatedAt'
             ]) &&
             data.participants is list &&
             data.participants.size() >= 1 && data.participants.size() <= 50 &&
             data.participants[0] is string && data.participants[0].size() >= 1 && data.participants[0].size() <= 128 &&
             (!('isGroup' in data) || data.isGroup == null || data.isGroup is bool) &&
             (!('isSelfChat' in data) || data.isSelfChat == null || data.isSelfChat is bool) &&
             (!('groupName' in data) || data.groupName == null || (data.groupName is string && data.groupName.size() <= 80)) &&
             (!('groupDescription' in data) || data.groupDescription == null || (data.groupDescription is string && data.groupDescription.size() <= 300)) &&
             (!('groupPhotoUrl' in data) || data.groupPhotoUrl == null || (data.groupPhotoUrl is string && data.groupPhotoUrl.size() <= 500)) &&
             (!('adminUids' in data) || data.adminUids == null || isValidUidList(data.adminUids)) &&
             (!('onlyAdminsCanSend' in data) || data.onlyAdminsCanSend == null || data.onlyAdminsCanSend is bool) &&
             (!('streakCount' in data) || data.streakCount == null || (data.streakCount is int && data.streakCount >= 0 && data.streakCount <= 9999)) &&
             (!('lastStreakDate' in data) || data.lastStreakDate == null || (data.lastStreakDate is string && data.lastStreakDate.size() <= 10)) &&
             (data.get('isGroup', false) == true ||
              (data.get('isSelfChat', false) == true && data.participants.size() == 1) ||
              (data.participants.size() == 2 && data.participants[0] != data.participants[1])) &&
             data.participantNames is map && data.participantNames.size() <= 50 &&
             data.participantPhotos is map && data.participantPhotos.size() <= 50 &&
             data.lastMessage is string && data.lastMessage.size() <= 500 &&
             data.lastMessageType in ['text', 'image', 'document', 'audio', 'call', 'poll', 'system', 'sticker', 'location', 'contact'] &&
             data.lastSenderId is string && data.lastSenderId.size() <= 128 &&
             data.lastMessageTime is timestamp && data.lastMessageTime <= request.time &&
             (!('lastMessageDelivered' in data) || data.lastMessageDelivered == null || data.lastMessageDelivered is bool) &&
             (!('lastMessageRead' in data) || data.lastMessageRead == null || data.lastMessageRead is bool) &&
             data.unreadCounts is map && data.unreadCounts.size() <= 50 &&
             isValidUidList(data.typingUids) &&
             (!('pinnedMessageId' in data) || data.pinnedMessageId == null || (data.pinnedMessageId is string && data.pinnedMessageId.size() <= 128)) &&
             (!('pinnedMessageText' in data) || data.pinnedMessageText == null || (data.pinnedMessageText is string && data.pinnedMessageText.size() <= 300)) &&
             (!('pinnedMessageSender' in data) || data.pinnedMessageSender == null || (data.pinnedMessageSender is string && data.pinnedMessageSender.size() <= 80)) &&
             (!('disappearingHours' in data) || data.disappearingHours == null || data.disappearingHours in [0, 24, 168]) &&
             (!('mutedBy' in data) || data.mutedBy == null || isValidUidList(data.mutedBy)) &&
             (!('pinnedBy' in data) || data.pinnedBy == null || isValidUidList(data.pinnedBy)) &&
             (!('archivedBy' in data) || data.archivedBy == null || isValidUidList(data.archivedBy)) &&
             (!('hiddenBy' in data) || data.hiddenBy == null || isValidUidList(data.hiddenBy)) &&
             (!('clearedAt' in data) || data.clearedAt == null || (data.clearedAt is map && data.clearedAt.size() <= 50)) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
               'chatId', 'senderId', 'participants', 'text', 'type',
               'delivered', 'read', 'deleted', 'timestamp', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'chatId', 'senderId', 'senderName', 'participants', 'text', 'type',
               'mediaUrl', 'mediaName', 'mediaSizeBytes', 'audioDurationSec',
               'callType', 'callStatus', 'callDurationSec',
               'viewOnce', 'viewedBy',
               'pollQuestion', 'pollOptions', 'pollVotes',
               'stickerId', 'latitude', 'longitude', 'locationLabel',
               'sharedContactUid', 'sharedContactName', 'sharedContactUsername', 'sharedContactPhotoUrl',
               'delivered', 'read', 'deleted', 'deletedFor', 'edited', 'forwarded',
               'replyToId', 'replyToText', 'replyToSenderName',
               'reactions', 'starredBy', 'expiresAt',
               'timestamp', 'updatedAt'
             ]) &&
             data.chatId is string && data.chatId.size() >= 1 && data.chatId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             (!('senderName' in data) || data.senderName == null || (data.senderName is string && data.senderName.size() <= 80)) &&
             data.participants is list &&
             data.participants.size() >= 1 && data.participants.size() <= 50 &&
             data.participants[0] is string &&
             data.text is string && data.text.size() <= 4000 &&
             data.type in ['text', 'image', 'document', 'audio', 'call', 'poll', 'system', 'sticker', 'location', 'contact'] &&
             (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 1000)) &&
             (!('mediaName' in data) || data.mediaName == null || (data.mediaName is string && data.mediaName.size() <= 200)) &&
             (!('mediaSizeBytes' in data) || data.mediaSizeBytes == null || (data.mediaSizeBytes is int && data.mediaSizeBytes >= 0 && data.mediaSizeBytes <= 10485760)) &&
             (!('audioDurationSec' in data) || data.audioDurationSec == null || (data.audioDurationSec is int && data.audioDurationSec >= 0 && data.audioDurationSec <= 600)) &&
             (!('callType' in data) || data.callType == null || data.callType in ['audio', 'video']) &&
             (!('callStatus' in data) || data.callStatus == null || data.callStatus in ['answered', 'missed', 'declined', 'busy']) &&
             (!('callDurationSec' in data) || data.callDurationSec == null || (data.callDurationSec is int && data.callDurationSec >= 0 && data.callDurationSec <= 86400)) &&
             (!('viewOnce' in data) || data.viewOnce == null || data.viewOnce is bool) &&
             (!('viewedBy' in data) || data.viewedBy == null || isValidUidList(data.viewedBy)) &&
             (!('pollQuestion' in data) || data.pollQuestion == null || (data.pollQuestion is string && data.pollQuestion.size() <= 240)) &&
             (!('pollOptions' in data) || data.pollOptions == null || (data.pollOptions is list && data.pollOptions.size() <= 6)) &&
             (!('pollVotes' in data) || data.pollVotes == null || (data.pollVotes is map && data.pollVotes.size() <= 100)) &&
             (!('stickerId' in data) || data.stickerId == null || (data.stickerId is string && data.stickerId.size() <= 64)) &&
             (!('latitude' in data) || data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             (!('locationLabel' in data) || data.locationLabel == null || (data.locationLabel is string && data.locationLabel.size() <= 160)) &&
             (!('sharedContactUid' in data) || data.sharedContactUid == null || (data.sharedContactUid is string && data.sharedContactUid.size() <= 128)) &&
             (!('sharedContactName' in data) || data.sharedContactName == null || (data.sharedContactName is string && data.sharedContactName.size() <= 80)) &&
             (!('sharedContactUsername' in data) || data.sharedContactUsername == null || (data.sharedContactUsername is string && data.sharedContactUsername.size() <= 40)) &&
             (!('sharedContactPhotoUrl' in data) || data.sharedContactPhotoUrl == null || (data.sharedContactPhotoUrl is string && data.sharedContactPhotoUrl.size() <= 500)) &&
             data.delivered is bool &&
             data.read is bool &&
             data.deleted is bool &&
             (!('deletedFor' in data) || data.deletedFor == null || isValidUidList(data.deletedFor)) &&
             (!('edited' in data) || data.edited == null || data.edited is bool) &&
             (!('forwarded' in data) || data.forwarded == null || data.forwarded is bool) &&
             (!('replyToId' in data) || data.replyToId == null || (data.replyToId is string && data.replyToId.size() <= 128)) &&
             (!('replyToText' in data) || data.replyToText == null || (data.replyToText is string && data.replyToText.size() <= 300)) &&
             (!('replyToSenderName' in data) || data.replyToSenderName == null || (data.replyToSenderName is string && data.replyToSenderName.size() <= 80)) &&
             (!('reactions' in data) || data.reactions == null || (data.reactions is map && data.reactions.size() <= 50)) &&
             (!('starredBy' in data) || data.starredBy == null || isValidUidList(data.starredBy)) &&
             (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp) &&
             data.timestamp is timestamp && data.timestamp <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStatus(data) {
      return data.keys().hasAll([
               'uid', 'authorName', 'type', 'text', 'viewerUids', 'expiresAt', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'uid', 'authorName', 'authorPhotoUrl', 'type', 'text',
               'mediaUrl', 'backgroundColorHex', 'viewerUids', 'expiresAt', 'createdAt'
             ]) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             (!('authorPhotoUrl' in data) || data.authorPhotoUrl == null || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500)) &&
             data.type in ['text', 'image'] &&
             data.text is string && data.text.size() <= 500 &&
             (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 1000)) &&
             (!('backgroundColorHex' in data) || data.backgroundColorHex == null || data.backgroundColorHex is int) &&
             data.viewerUids is list && data.viewerUids.size() <= 200 &&
             data.expiresAt is timestamp &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCallSession(data) {
      return data.keys().hasAll([
               'callerUid', 'callerName', 'calleeUid', 'calleeName',
               'participants', 'callType', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'callerUid', 'callerName', 'callerPhotoUrl',
               'calleeUid', 'calleeName', 'calleePhotoUrl',
               'participants', 'callType', 'status',
               'offerSdp', 'answerSdp', 'createdAt', 'updatedAt'
             ]) &&
             data.callerUid is string && data.callerUid.size() >= 1 && data.callerUid.size() <= 128 &&
             data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 60 &&
             (!('callerPhotoUrl' in data) || data.callerPhotoUrl == null || (data.callerPhotoUrl is string && data.callerPhotoUrl.size() <= 500)) &&
             data.calleeUid is string && data.calleeUid.size() >= 1 && data.calleeUid.size() <= 128 &&
             data.calleeName is string && data.calleeName.size() >= 1 && data.calleeName.size() <= 60 &&
             (!('calleePhotoUrl' in data) || data.calleePhotoUrl == null || (data.calleePhotoUrl is string && data.calleePhotoUrl.size() <= 500)) &&
             data.callerUid != data.calleeUid &&
             data.participants is list && data.participants.size() == 2 &&
             data.callerUid in data.participants && data.calleeUid in data.participants &&
             data.callType in ['audio', 'video'] &&
             data.status in ['calling', 'ringing', 'accepted', 'declined', 'ended', 'missed', 'busy'] &&
             (!('offerSdp' in data) || data.offerSdp == null || (data.offerSdp is string && data.offerSdp.size() <= 25000)) &&
             (!('answerSdp' in data) || data.answerSdp == null || (data.answerSdp is string && data.answerSdp.size() <= 25000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidIceCandidate(data) {
      return data.keys().hasAll(['senderUid', 'participants', 'sdpMid', 'sdpMLineIndex', 'sdp', 'createdAt']) &&
             data.keys().hasOnly(['senderUid', 'participants', 'sdpMid', 'sdpMLineIndex', 'sdp', 'createdAt']) &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.participants is list && data.participants.size() == 2 &&
             data.senderUid in data.participants &&
             data.sdpMid is string && data.sdpMid.size() <= 64 &&
             data.sdpMLineIndex is int && data.sdpMLineIndex >= 0 && data.sdpMLineIndex <= 32 &&
             data.sdp is string && data.sdp.size() >= 1 && data.sdp.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUsernameId(username) {
      return username is string &&
             username.size() >= 3 &&
             username.size() <= 30 &&
             username.matches('^[a-z0-9_]+$');
    }

    function isValidUsernameClaim(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'createdAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidModerationStatus(data) {
      return data.keys().hasAll(['uid', 'banned', 'deletedByAdmin', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'banned', 'deletedByAdmin', 'mutedUntil', 'reason', 'updatedBy', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.banned is bool &&
             data.deletedByAdmin is bool &&
             (!('mutedUntil' in data) || data.mutedUntil == null || data.mutedUntil is timestamp) &&
             (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 300)) &&
             (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAppBroadcast(data) {
      return data.keys().hasAll(['active', 'broadcastId', 'title', 'message', 'severity', 'updatedAt']) &&
             data.keys().hasOnly(['active', 'broadcastId', 'title', 'message', 'severity', 'updatedBy', 'updatedAt']) &&
             data.active is bool &&
             data.broadcastId is string && data.broadcastId.size() <= 64 &&
             data.title is string && data.title.size() <= 120 &&
             data.message is string && data.message.size() <= 600 &&
             data.severity in ['info', 'update', 'warning'] &&
             (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidModerationSettings(data) {
      return data.keys().hasAll([
               'profanityFilterEnabled', 'profanityMode',
               'spamProtectionEnabled', 'telegramAlertsEnabled',
               'customBlockedWords', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'profanityFilterEnabled', 'profanityMode',
               'spamProtectionEnabled', 'telegramAlertsEnabled',
               'customBlockedWords', 'updatedBy', 'updatedAt'
             ]) &&
             data.profanityFilterEnabled is bool &&
             data.profanityMode in ['block', 'mask'] &&
             data.spamProtectionEnabled is bool &&
             data.telegramAlertsEnabled is bool &&
             data.customBlockedWords is list && data.customBlockedWords.size() <= 200 &&
             (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAppUpdateConfig(data) {
      return data.keys().hasAll([
               'active', 'latestVersionCode', 'latestVersionName',
               'forceUpdate', 'apkUrl', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'active', 'latestVersionCode', 'latestVersionName',
               'forceUpdate', 'apkUrl', 'releaseUrl', 'releaseNotes',
               'updatedBy', 'updatedAt'
             ]) &&
             data.active is bool &&
             data.latestVersionCode is int && data.latestVersionCode >= 1 && data.latestVersionCode <= 100000 &&
             data.latestVersionName is string && data.latestVersionName.size() >= 1 && data.latestVersionName.size() <= 32 &&
             data.forceUpdate is bool &&
             data.apkUrl is string && data.apkUrl.size() >= 8 && data.apkUrl.size() <= 1000 &&
             (!('releaseUrl' in data) || data.releaseUrl == null || (data.releaseUrl is string && data.releaseUrl.size() <= 1000)) &&
             (!('releaseNotes' in data) || data.releaseNotes == null || (data.releaseNotes is string && data.releaseNotes.size() <= 1000)) &&
             (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- PUBLIC PROFILES COLLECTION (NO PII) ---

    match /profiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.discoverable == true || isSuperAdmin());

      allow create: if isOwner(uid) &&
                       isValidId(uid) &&
                       incoming().uid == uid &&
                       incoming().get('verified', false) == false &&
                       isValidPublicProfile(incoming());

      allow update: if isValidId(uid) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt && (
                         (isOwner(uid) && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'username', 'phoneLookup', 'photoUrl', 'about',
                             'discoverable', 'showOnlineStatus', 'showLastSeen',
                             'showReadReceipts', 'showProfilePhoto', 'showAbout',
                             'online', 'lastSeen', 'updatedAt'
                           ]) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['online', 'lastSeen', 'updatedAt'])
                         )) ||
                         (isSuperAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['verified', 'updatedAt']))
                       );

      allow delete: if (isOwner(uid) || isSuperAdmin()) && isValidId(uid);
    }

    // --- UNIQUE @USERNAME REGISTRY ---

    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsernameId(username);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidUsernameId(username) &&
                       incoming().uid == request.auth.uid &&
                       isValidUsernameClaim(incoming());

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidUsernameId(username) &&
                       (existing().uid == request.auth.uid || isSuperAdmin());
    }

    // --- PRIVATE USERS COLLECTION (STRICT OWNER-ONLY PII, SUPER ADMIN MODERATION AUDIT) ---

    match /users/{uid} {
      allow get: if (isOwner(uid) || isSuperAdmin()) && isValidId(uid);
      allow list: if isSuperAdmin();

      allow create: if isOwner(uid) &&
                       isValidId(uid) &&
                       incoming().uid == uid &&
                       isValidPrivateUser(incoming());

      allow update: if isOwner(uid) &&
                       isValidId(uid) &&
                       isValidPrivateUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt && (
                         incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'messagePreviewEnabled', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['fcmToken', 'updatedAt'])
                       );

      allow delete: if (isOwner(uid) || isSuperAdmin()) && isValidId(uid);

      match /blockedUsers/{blockedUid} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(blockedUid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) &&
                         isValidId(uid) &&
                         isValidId(blockedUid) &&
                         blockedUid != uid &&
                         incoming().blockedUid == blockedUid &&
                         isValidBlockedUser(incoming());
        allow update: if isOwner(uid) &&
                         isValidId(uid) &&
                         isValidId(blockedUid) &&
                         blockedUid != uid &&
                         incoming().blockedUid == existing().blockedUid &&
                         isValidBlockedUser(incoming());
        allow delete: if isOwner(uid) && isValidId(uid) && isValidId(blockedUid);
      }

      match /favorites/{favoriteUid} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(favoriteUid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) &&
                         isValidId(uid) &&
                         isValidId(favoriteUid) &&
                         favoriteUid != uid &&
                         incoming().favoriteUid == favoriteUid &&
                         isValidFavoriteContact(incoming());
        allow update: if isOwner(uid) &&
                         isValidId(uid) &&
                         isValidId(favoriteUid) &&
                         favoriteUid != uid &&
                         incoming().favoriteUid == existing().favoriteUid &&
                         isValidFavoriteContact(incoming());
        allow delete: if isOwner(uid) && isValidId(uid) && isValidId(favoriteUid);
      }

      match /callLogs/{callId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(callId);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) &&
                         isValidId(uid) &&
                         isValidId(callId) &&
                         isValidCallLog(incoming());
        allow update: if false;
        allow delete: if isOwner(uid) && isValidId(uid) && isValidId(callId);
      }
    }

    // --- USER REPORTS COLLECTION ---

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterUid == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().reportedUid != request.auth.uid &&
                       isValidReport(incoming());
      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(reportId);
    }

    // --- SUPER ADMIN MODERATION COLLECTION (BAN / TIMED MUTE / REMOVAL) ---

    match /moderation/{uid} {
      allow get: if (isOwner(uid) || isSuperAdmin()) && isValidId(uid);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
                       isValidId(uid) &&
                       incoming().uid == uid &&
                       isValidModerationStatus(incoming());
      allow update: if isSuperAdmin() &&
                       isValidId(uid) &&
                       incoming().uid == uid &&
                       isValidModerationStatus(incoming());
      allow delete: if isSuperAdmin() && isValidId(uid);
    }

    // --- GLOBAL APP CONFIG (BROADCAST NOTICES & AUTO-MODERATION SETTINGS) ---

    match /appConfig/{configId} {
      allow get: if isSignedIn() && configId in ['broadcast', 'moderation', 'appUpdate'];
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && (
        (configId == 'broadcast' && isValidAppBroadcast(incoming())) ||
        (configId == 'moderation' && isValidModerationSettings(incoming())) ||
        (configId == 'appUpdate' && isValidAppUpdateConfig(incoming()))
      );
      allow delete: if isSuperAdmin() && configId in ['broadcast', 'moderation', 'appUpdate'];
    }

    // --- 24-HOUR STATUS STORIES ---

    match /statuses/{statusId} {
      allow get: if isSignedIn() && isValidId(statusId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(statusId) &&
                       isNotModRestricted(request.auth.uid) &&
                       incoming().uid == request.auth.uid &&
                       incoming().expiresAt > request.time &&
                       isValidStatus(incoming());

      allow update: if isSignedIn() &&
                       isValidId(statusId) &&
                       isValidStatus(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().expiresAt == existing().expiresAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['viewerUids']) &&
                       request.auth.uid in incoming().viewerUids;

      allow delete: if isSignedIn() &&
                       isValidId(statusId) &&
                       (existing().uid == request.auth.uid || isSuperAdmin());
    }

    // --- REAL-TIME WEBRTC CALL SESSIONS ---

    match /callSessions/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() &&
                       isValidId(callId) &&
                       isNotModRestricted(request.auth.uid) &&
                       incoming().callerUid == request.auth.uid &&
                       incoming().status in ['calling', 'ringing'] &&
                       isValidCallSession(incoming()) &&
                       !isBlockedBetween(incoming().callerUid, incoming().calleeUid);

      allow update: if isSignedIn() &&
                       isValidId(callId) &&
                       isValidCallSession(incoming()) &&
                       request.auth.uid in existing().participants &&
                       incoming().callerUid == existing().callerUid &&
                       incoming().calleeUid == existing().calleeUid &&
                       incoming().participants == existing().participants &&
                       incoming().callType == existing().callType &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'offerSdp', 'answerSdp', 'updatedAt'
                       ]);

      allow delete: if false;

      match /candidates/{candidateId} {
        allow get: if isSignedIn() && isValidId(callId) && isValidId(candidateId) && request.auth.uid in existing().participants;
        allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
        allow create: if isSignedIn() &&
                         isValidId(callId) &&
                         isValidId(candidateId) &&
                         incoming().senderUid == request.auth.uid &&
                         isValidIceCandidate(incoming()) &&
                         exists(/databases/$(database)/documents/callSessions/$(callId)) &&
                         get(/databases/$(database)/documents/callSessions/$(callId)).data.participants == incoming().participants;
        allow update: if false;
        allow delete: if false;
      }
    }

    function isGroupAdminData(chatData, uid) {
      return chatData.get('isGroup', false) == true &&
             (uid == chatData.createdBy || uid in chatData.get('adminUids', []));
    }

    function isChatParticipant(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) &&
             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isGroupAdminOfChat(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) &&
             isGroupAdminData(get(/databases/$(database)/documents/chats/$(chatId)).data, request.auth.uid);
    }

    function isValidChatUpdateAction(changed) {
      let old = resource.data;
      let next = request.resource.data;
      let isGroupChat = old.get('isGroup', false) == true;
      let isAdmin = isGroupChat && (request.auth.uid == old.createdBy || request.auth.uid in old.get('adminUids', []));
      return (next.participants == old.participants && (
               // Action 1: Per-user flags (pin/mute/archive/hide/clear), typing, unread reset, or delivery/read receipts
               (changed.hasOnly([
                  'unreadCounts', 'lastMessageDelivered', 'lastMessageRead', 'typingUids',
                  'mutedBy', 'pinnedBy', 'archivedBy', 'hiddenBy', 'clearedAt', 'updatedAt'
                ]) &&
                (!('clearedAt' in changed) ||
                 next.get('clearedAt', {}).diff(old.get('clearedAt', {})).affectedKeys().hasOnly([request.auth.uid]))) ||
               // Action 2: Send/update last message metadata, streak, unread counts, or auto-unhide on new message
               (changed.hasOnly([
                  'lastMessage', 'lastMessageType', 'lastSenderId', 'lastMessageTime',
                  'lastMessageDelivered', 'lastMessageRead', 'hiddenBy',
                  'streakCount', 'lastStreakDate',
                  'unreadCounts', 'typingUids', 'participantNames', 'participantPhotos', 'updatedAt'
                ]) &&
                isNotModRestricted(request.auth.uid) &&
                !isDirectChatBlocked(old) &&
                (!(isGroupChat && old.get('onlyAdminsCanSend', false) == true) ||
                 isAdmin ||
                 next.lastMessageType == 'system')) ||
               // Action 3: Pin/unpin message or update disappearing timer (any participant in 1-on-1; Group Admin only in groups)
               ((!isGroupChat || isAdmin) &&
                changed.hasOnly([
                  'pinnedMessageId', 'pinnedMessageText', 'pinnedMessageSender',
                  'disappearingHours', 'updatedAt'
                ]))
             )) ||
             // Action 4: Group Admin / Creator updates group name, description, photo, settings, or membership
             (isAdmin &&
              next.get('isGroup', false) == true &&
              (request.auth.uid == old.createdBy ||
               !(old.createdBy in old.participants) ||
               old.createdBy in next.participants) &&
              (request.auth.uid == old.createdBy ||
               !(old.createdBy in old.get('adminUids', [])) ||
               old.createdBy in next.get('adminUids', [])) &&
              changed.hasOnly([
                'groupName', 'groupDescription', 'groupPhotoUrl', 'participants',
                'participantNames', 'participantPhotos', 'unreadCounts',
                'adminUids', 'onlyAdminsCanSend', 'mutedBy', 'pinnedBy', 'archivedBy', 'typingUids', 'updatedAt'
              ])) ||
             // Action 5: Group member leaves the group voluntarily
             (isGroupChat &&
              next.get('isGroup', false) == true &&
              !(request.auth.uid in next.participants) &&
              next.participants.size() == old.participants.size() - 1 &&
              changed.hasOnly([
                'participants', 'participantNames', 'participantPhotos', 'unreadCounts',
                'adminUids', 'typingUids', 'mutedBy', 'pinnedBy', 'archivedBy', 'updatedAt'
              ]));
    }

    function canUpdateChat() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isValidChatUpdateFields(request.resource.data, changed) &&
             isValidChatUpdateAction(changed);
    }

    function isValidMessageUpdateAction(chatId, changed) {
      let old = resource.data;
      let next = request.resource.data;
      return // Action 1: Recipient updates delivery/read receipt
             (request.auth.uid != old.senderId &&
              changed.hasOnly(['delivered', 'read', 'updatedAt'])) ||
             // Action 2: Participant adds/removes reaction or stars/unstars a message
             changed.hasOnly(['reactions', 'starredBy', 'updatedAt']) ||
             // Action 3: Sender or Group Admin soft-deletes message for everyone
             (next.deleted == true &&
              next.text == '' &&
              changed.hasOnly(['deleted', 'text', 'mediaUrl', 'mediaName', 'updatedAt']) &&
              (request.auth.uid == old.senderId || isGroupAdminOfChat(chatId))) ||
             // Action 4: Sender edits own non-deleted text message
             (request.auth.uid == old.senderId &&
              old.deleted == false &&
              old.type == 'text' &&
              next.deleted == false &&
              next.edited == true &&
              next.text.size() >= 1 &&
              changed.hasOnly(['text', 'edited', 'updatedAt'])) ||
             // Action 5: Participant hides/deletes any message for themselves only
             (changed.hasOnly(['deletedFor', 'updatedAt']) &&
              request.auth.uid in next.deletedFor &&
              (old.get('deletedFor', []).size() == 0 ||
               next.deletedFor.hasAll(old.get('deletedFor', [])))) ||
             // Action 6: Recipient marks view-once photo as opened
             (old.get('viewOnce', false) == true &&
              request.auth.uid != old.senderId &&
              changed.hasOnly(['viewedBy', 'updatedAt']) &&
              request.auth.uid in next.viewedBy &&
              (old.get('viewedBy', []).size() == 0 ||
               next.viewedBy.hasAll(old.get('viewedBy', [])))) ||
             // Action 7: Participant casts or updates their own vote on a poll
             (old.type == 'poll' &&
              old.deleted == false &&
              changed.hasOnly(['pollVotes', 'updatedAt']) &&
              next.pollVotes.diff(old.get('pollVotes', {})).affectedKeys().hasOnly([request.auth.uid]));
    }

    function canUpdateMessage(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isValidMessageUpdateFields(request.resource.data, changed) &&
             isValidMessageUpdateAction(chatId, changed);
    }

    function isValidChatUpdateFields(data, changed) {
      return data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('participants' in changed) || (data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 50)) &&
             (!('groupName' in changed) || data.groupName == null || (data.groupName is string && data.groupName.size() <= 80)) &&
             (!('groupDescription' in changed) || data.groupDescription == null || (data.groupDescription is string && data.groupDescription.size() <= 300)) &&
             (!('groupPhotoUrl' in changed) || data.groupPhotoUrl == null || (data.groupPhotoUrl is string && data.groupPhotoUrl.size() <= 500)) &&
             (!('adminUids' in changed) || data.adminUids == null || isValidUidList(data.adminUids)) &&
             (!('onlyAdminsCanSend' in changed) || data.onlyAdminsCanSend == null || data.onlyAdminsCanSend is bool) &&
             (!('lastMessage' in changed) || (data.lastMessage is string && data.lastMessage.size() <= 500)) &&
             (!('lastMessageType' in changed) || data.lastMessageType in ['text', 'image', 'document', 'audio', 'call', 'poll', 'system', 'sticker', 'location', 'contact']) &&
             (!('lastMessageTime' in changed) || (data.lastMessageTime is timestamp && data.lastMessageTime <= request.time)) &&
             (!('streakCount' in changed) || data.streakCount == null || (data.streakCount is int && data.streakCount >= 0 && data.streakCount <= 9999)) &&
             (!('lastStreakDate' in changed) || data.lastStreakDate == null || (data.lastStreakDate is string && data.lastStreakDate.size() <= 10)) &&
             (!('disappearingHours' in changed) || data.disappearingHours == null || data.disappearingHours in [0, 24, 168]) &&
             (!('pinnedMessageText' in changed) || data.pinnedMessageText == null || (data.pinnedMessageText is string && data.pinnedMessageText.size() <= 300)) &&
             (!('typingUids' in changed) || isValidUidList(data.typingUids)) &&
             (!('mutedBy' in changed) || data.mutedBy == null || isValidUidList(data.mutedBy)) &&
             (!('pinnedBy' in changed) || data.pinnedBy == null || isValidUidList(data.pinnedBy)) &&
             (!('archivedBy' in changed) || data.archivedBy == null || isValidUidList(data.archivedBy)) &&
             (!('hiddenBy' in changed) || data.hiddenBy == null || isValidUidList(data.hiddenBy)) &&
             (!('clearedAt' in changed) || data.clearedAt == null || (data.clearedAt is map && data.clearedAt.size() <= 50));
    }

    function isValidMessageUpdateFields(data, changed) {
      return data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('delivered' in changed) || data.delivered is bool) &&
             (!('read' in changed) || data.read is bool) &&
             (!('deleted' in changed) || data.deleted is bool) &&
             (!('edited' in changed) || data.edited == null || data.edited is bool) &&
             (!('text' in changed) || (data.text is string && data.text.size() <= 4000)) &&
             (!('mediaUrl' in changed) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 1000)) &&
             (!('mediaName' in changed) || data.mediaName == null || (data.mediaName is string && data.mediaName.size() <= 200)) &&
             (!('reactions' in changed) || data.reactions == null || (data.reactions is map && data.reactions.size() <= 50)) &&
             (!('starredBy' in changed) || data.starredBy == null || isValidUidList(data.starredBy)) &&
             (!('deletedFor' in changed) || data.deletedFor == null || isValidUidList(data.deletedFor)) &&
             (!('viewedBy' in changed) || data.viewedBy == null || isValidUidList(data.viewedBy)) &&
             (!('pollVotes' in changed) || data.pollVotes == null || (data.pollVotes is map && data.pollVotes.size() <= 100));
    }

    function canSendMessageInChat(chatData) {
      return chatData.participants == incoming().participants &&
             !isDirectChatBlocked(chatData) &&
             (incoming().type == 'system' && chatData.get('isGroup', false) == true ||
              !(chatData.get('isGroup', false) == true &&
                chatData.get('onlyAdminsCanSend', false) == true) ||
              isGroupAdminData(chatData, request.auth.uid));
    }

    // --- CHATS & REAL-TIME MESSAGES (1-on-1 & GROUPS) ---

    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (
                   (resource == null && isDirectChatIdForUser(chatId, request.auth.uid)) ||
                   (resource != null && request.auth.uid in existing().participants)
                 );
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       isNotModRestricted(request.auth.uid) &&
                       incoming().createdBy == request.auth.uid &&
                       request.auth.uid in incoming().participants &&
                       (incoming().participants.size() >= 2 ||
                        (chatId == 'saved_' + request.auth.uid &&
                         incoming().get('isSelfChat', false) == true &&
                         incoming().participants == [request.auth.uid])) &&
                       isValidChat(incoming()) &&
                       !isDirectChatBlocked(incoming());

      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       request.auth.uid in resource.data.participants &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       canUpdateChat();

      allow delete: if isSignedIn() &&
                       isValidId(chatId) &&
                       existing().get('isGroup', false) == true &&
                       (isGroupAdminData(existing(), request.auth.uid) ||
                        existing().participants == [request.auth.uid] ||
                        isSuperAdmin());

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && isChatParticipant(chatId);
        allow list: if isSignedIn() && isValidId(chatId) && isChatParticipant(chatId);

        allow create: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         isNotModRestricted(request.auth.uid) &&
                         incoming().chatId == chatId &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participants &&
                         isValidMessage(incoming()) &&
                         exists(/databases/$(database)/documents/chats/$(chatId)) &&
                         canSendMessageInChat(get(/databases/$(database)/documents/chats/$(chatId)).data);

        allow update: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         isChatParticipant(chatId) &&
                         request.resource.data.chatId == resource.data.chatId &&
                         request.resource.data.senderId == resource.data.senderId &&
                         request.resource.data.participants == resource.data.participants &&
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         canUpdateMessage(chatId);

        allow delete: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid ||
                          isGroupAdminOfChat(chatId) ||
                          (exists(/databases/$(database)/documents/chats/$(chatId)) &&
                           get(/databases/$(database)/documents/chats/$(chatId)).data.participants == [request.auth.uid]) ||
                          isSuperAdmin());
      }
    }
  }
}
